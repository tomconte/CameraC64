<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  What project.yml's INFOPLIST_KEY_ settings cannot say. Xcode adds those
  settings' keys to these when it builds the app's Info.plist.
-->
<plist version="1.0">
<dict>
	<!-- Send to C64 talks to an Ultimate over plain HTTP, as its REST API offers, on the local network only. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- The C64 files that Share offers. No app owns these types, so the app imports them. -->
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.camerac64.prg</string>
			<key>UTTypeDescription</key>
			<string>Commodore 64 program</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>prg</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.camerac64.d64</string>
			<key>UTTypeDescription</key>
			<string>Commodore 1541 disk image</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>d64</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.camerac64.koala</string>
			<key>UTTypeDescription</key>
			<string>Koala Painter picture</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>kla</string>
					<string>koa</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.camerac64.art-studio</string>
			<key>UTTypeDescription</key>
			<string>Art Studio picture</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>art</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
